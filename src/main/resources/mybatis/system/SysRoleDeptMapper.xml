<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.geekplus.webapp.system.mapper.SysRoleDeptMapper">
    <resultMap id="BaseResultMap" type="com.geekplus.webapp.system.entity.SysRoleDept">
        <result property="roleId" column="role_id" jdbcType="BIGINT"/>
        <result property="deptId" column="dept_id" jdbcType="BIGINT"/>
    </resultMap>

    <!-- 角色已勾选的部门 ID，供 roleDeptTreeselect.checkedKeys 使用 -->
    <select id="selectDeptIdsByRoleId" resultType="Long">
        select dept_id from sys_role_dept where role_id = #{roleId}
    </select>

    <delete id="deleteByRoleId">
        delete from sys_role_dept where role_id = #{roleId}
    </delete>

    <insert id="batchInsert">
        insert into sys_role_dept (role_id, dept_id) values
        <foreach collection="list" item="item" separator=",">
            (#{item.roleId}, #{item.deptId})
        </foreach>
    </insert>

    <select id="selectRolesDepts" parameterType="SysRoleDept" resultMap="BaseResultMap">
        select role_id, dept_id from sys_role_dept
        <where>
            <if test="roleId != null">
                AND role_id = #{roleId}
            </if>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>
        </where>
    </select>
</mapper>
